# Copy to oracle-vps.env and fill values that differ from defaults.

REGION=ap-singapore-1
INSTANCE_NAME=oracle-vps
HOSTNAME_LABEL=oracle-vps
VCN_NAME=main-vcn
SUBNET_NAME=public-subnet
SSH_PUBKEY_FILE="$HOME/.ssh/oracle-vps.pub"

# Empty means root tenancy compartment.
COMPARTMENT_OCID=

# A1 Always Free target.
A1_OCPUS=1
A1_MEMORY_GBS=6
A1_INTERVAL_SECONDS=3000
A1_JITTER_SECONDS=300

# E2 is only considered after A1 and only with this probability.
E2_PROBABILITY=0.30
E2_DELAY_AFTER_A1_SECONDS=1200
E2_JITTER_SECONDS=300

# Optional: pin E2 to a known supported availability domain.
E2_AD_NAME=

# Optional Telegram notification.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
